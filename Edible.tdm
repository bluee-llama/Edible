            private contenido : String (0, 1);
            private valoracion : Integer (1,1);
        }
        
        operations
        {
            public new::New (p_user_id : Integer, p_titulo : String, p_valoracion : Integer, p_comentador_oid : OID -> Usuario, p_receta_oid : OID -> Receta) : Object->Comentario;
            public destroy::Destroy (p_oid : OID -> Comentario) : Void;
            public modify::Modifier (p_oid : OID -> Comentario, p_user_id : Integer, p_titulo : String, p_valoracion : Integer) : Void;
            public readOID::ReadOID (p_oid : OID -> Comentario) : Object->Comentario;
            public readAll::ReadAll () : List<Object->Comentario>;
            public recalcularValoracionMedia::CustomTransaction (p_user_id : Integer, p_titulo : String, p_valoracion : Integer, p_comentador_oid : OID -> Usuario, p_roleB_oid : OID -> Receta) : Object->Comentario; 
        }
    };


