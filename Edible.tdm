    Enumeration TipoIngrediente
    {
        (ninguno, 0)(bebidas_alcoholicas, 1), (grasas_y_aceites_vegetales_y_animales, 2), (cafe_cacao_te_e_infusiones, 3), (platos_preparados,4), (pescados_mariscos_anfibios_reptiles_e_invertebrados,5), (frutas_y_productos_a_base_de_fruta,6), (zumos_y_nectares_de_frutas_y_verduras,7), (cereales_y_productos_a_base_de_cereales,8), (legumbres_frutos_secos_semillas_oleaginosas_y_especias,9), (carne_y_productos_carnicos,10),(leche_y_productos_lacteos, 11), (productos_para_dietas_especiales_imitaciones_y_suplementos, 12), (sazonadores_salsas_y_condimentos, 13), (azucar_confiteria_y_postres_dulces_a_base_de_agua, 14), (hortalizas_verduras_y_sus_productos, 15), (agua_y_bebidas_a_base_de_agua, 16)
    };

    Enumeration DietaEspecial
    {
        (ninguna, 0),(vegetariana, 1), (sinGluten, 2), (sinLactosa, 3), (vegana, 4)
    };

    Enumeration Alergenos
    {
        (ninguno, 0),(frutos_secos, 1), (lactosa, 2), (gluten, 3), (huevo, 4), (soja, 5), (pescado, 6), (marisco, 7), (apio, 8), (mostaza, 9), (sulfitos, 10), (sesamo, 11), (altramuces, 12)
    };

    Enumeration EstadoCaducidad
    {
        (ninguno, 0),(perfecto, 1), (cerca, 2), (caducado, 3)
    };

    Association RecetasChef (Chef - Receta)
    {
        => navigable receta (0, *);
        <= navigable chef (1, 1);
    };

    Association PasosDeReceta (Receta - Paso)
    {
        => navigable pasos : Composite (0, *);
        <= navigable receta (1, 1);
    };

    Association Comentarios (Usuario - Comentario)
    {
        => navigable comentario (0, *);
        <= navigable comentador (1, 1);
    };
    
    Association RecetaLineas (Receta - LineaReceta)
    {
        => navigable lineas : Composite (1, *);
        <= navigable receta (1, 1);
    };

    Association IngredienteLineaReceta (Ingrediente - LineaReceta)
    {
        => navigable lineasDeReceta (0, *);
        <= navigable ingredienteCatalogo (1, 1);
    };
    
    Association NeveraUsuario (Usuario - Nevera)
    {
        => navigable nevera : Composite (1, 1);
        <= navigable usuario (1, 1);
    };

    Association ComentarioDeReceta (Receta - Comentario)
    {
        => navigable comentarios (0, *);
        <= navigable receta (1, 1);
    };
    
    Association ListaUsuario (Usuario - ListaCompra)
    {
        => navigable listaCompra : Composite (1, 1);
        <= navigable usuario (1, 1);
    };
    
    Association AlimentosDeLaNevera (Nevera - IngredienteCompra)
    {
        => navigable ingredienteEnLaLista : Composite (0, *);
        <= navigable nevera (1, 1);
    };

    Association AlimentosDeLaLista (ListaCompra - IngredienteCompra)
    {
        => navigable ingredienteEnLaLista : Composite (0, *);
        <= navigable listaCompra (1, 1);
    };
    
    Association TipoIngredienteCompra (Ingrediente - IngredienteCompra)
    {
        => navigable ingredienteEnCompra (0, *);
        <= navigable ingredienteCatalogo (1, 1);
    };

    Association TipoIngredienteNevera (Ingrediente - IngredienteNevera)
    {
        => navigable ingredienteEnNevera (0, *);
        <= navigable ingredienteCatalogo (1, 1);
    };

    Association IngredientesEnNevera (Nevera - IngredienteNevera)
    {
        => navigable ingredienteEnLaNevera : Composite (0, *);
        <= navigable nevera (1, 1);
    };
    
    Association IngredientesDisponibles (Receta - IngredienteNevera)
    {
        => navigable ingredientesDisponibles (0, *);
        <= navigable receta (1, 1);
    };

    Association RecetasSugeridas (Usuario - Receta)
    {
        => navigable recetasSugeridas (0, *);
        <= navigable usuariosSugeridos (0, *);
    };
    
}