ConceptualModel Edible
{
    Class Usuario <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private name : String (1, 1);
            private password : Password (1, 1);
            private publico : Boolean (1, 1);
            private dieta : DietaEspecial (1, 1);
        }
        
        operations
        {
            public new::New (p_name : String, p_password : Password, p_publico : Boolean, p_dieta : DietaEspecial, p_nevera : Object -> Nevera, p_listaCompra : Object -> ListaCompra) : Object->Usuario;
            public destroy::Destroy (p_oid : OID -> Usuario) : Void;
            public modify::Modifier (p_oid : OID -> Usuario, p_name : String, p_password : Password, p_publico : Boolean, p_dieta : DietaEspecial, p_nevera : Object -> Nevera, p_listaCompra : Object -> ListaCompra) : Void;
            public login::Login (p_oid : OID -> Usuario, p_password : Password) : String;
            public readOID::ReadOID (p_oid : OID -> Usuario) : Object->Usuario;
            public readAll::ReadAll () : List<Object->Usuario>;
            
            public ponerPublico::Custom (p_oid : OID -> Usuario) : Void;
            public ponerPrivado::Custom (p_oid : OID -> Usuario) : Void;
        }
    };

