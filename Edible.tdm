    Class Receta <AggregateRoot>
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1);
            private descripcion : String (1, 1);
            private dietaEspecial : DietaEspecial (1, 1);
            private valoracionMedia : Float (1,1);
            private tiempoRealizacion : Integer (1,1);
            private dificultad : Integer (1,1);
        }
        
        operations
        {
            public new::New (p_nombre : String, p_descripcion : String, p_dietaEspecial : DietaEspecial, p_valoracionMedia : Float, p_tiempoRealizacion : Integer, p_dificultad : Integer, p_chef_oid : OID -> Chef, p_lineas : List<Object -> LineaReceta>) : Object->Receta;
            public destroy::Destroy (p_oid : OID -> Receta) : Void;
            public modify::Modifier (p_oid : OID -> Receta, p_nombre : String, p_descripcion : String, p_dietaEspecial : DietaEspecial, p_valoracionMedia : Float, p_tiempoRealizacion : Integer, p_dificultad : Integer, p_chef_oid : OID -> Chef) : Void;
            public readOID::ReadOID (p_oid : OID -> Receta) : Object->Receta;
            public readAll::ReadAll () : List<Object->Receta>;
            public compartir::Custom (p_oid : OID -> Receta) : Void;public newLineaReceta::New (p_cantidadNecesaria : Integer, p_receta_oid : OID -> Receta, p_ingrediente_oid : OID -> Ingrediente) : Object->LineaReceta;

            public modifyLineaReceta::Modifier (p_oid : OID -> LineaReceta, p_cantidadNecesaria : Integer, p_receta_oid : OID -> Receta, p_ingrediente_oid : OID -> Ingrediente) : Void;
            public destroyLineaReceta::Destroy (p_oid : OID -> LineaReceta) : Void;
            public readOIDLineaReceta::ReadOID (p_oid : OID -> LineaReceta) : Object->LineaReceta;
            public readAllLineaReceta::ReadAll () : List<Object->LineaReceta>;

            public comprobarIngredientesDisponibles::CustomTransaction (p_nombre : String, p_descripcion : String, p_dietaEspecial : DietaEspecial, p_valoracionMedia : Float, p_chef_oid : OID -> Chef) : Object->Receta;
            public busquedaAvanzada::ReadFilter (
                    p_dieta : DietaEspecial, 
                    p_notaMinima : Float, 
                    p_tiempoMin : Integer, 
                    p_tiempoMax : Integer, 
                    p_dificultad : Integer,
                    p_alergenoExcluido : Alergenos,
                    p_ingrediente_oid : OID -> Ingrediente
                ) : List<Object->Receta>
                {
                    filterLinQ = "entity => (p_dieta == DietaEspecial.ninguna || entity.DietaEspecial == p_dieta) && entity.ValoracionMedia >= p_notaMinima && entity.TiempoRealizacion >= p_tiempoMin && (p_tiempoMax <= 0 || entity.TiempoRealizacion <= p_tiempoMax) && (p_dificultad <= 0 || entity.Dificultad == p_dificultad) && (p_alergenoExcluido == Alergenos.ninguno || !entity.Lineas.Any(l => l.IngredienteCatalogo.Alergenos.Contains(p_alergenoExcluido))) && (p_ingrediente_oid <= 0 || entity.Lineas.Any(l => l.IngredienteCatalogo.Id == p_ingrediente_oid))"
                };
            public buscarNombre::ReadFilter (p_nombre : String) : List<Object->Receta>
                {
                    filterLinQ = "entity => entity.Nombre == p_nombre"
                };
            public recetasPorNevera :: ReadFilter (p_nevera_oid : OID -> Nevera) : List<Object -> Receta>
                {
                    filterLinQ = "entity => entity.Lineas.All(linea => linea.IngredienteCatalogo.IngredienteEnNevera.Any(nev => nev.Nevera.Id == p_nevera_oid && nev.Cantidad >= linea.CantidadNecesaria))"
                };
        }
    };

    Class LineaReceta <AggregateMember:Receta>
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private cantidadNecesaria : Integer (1, 1);
        }
        operations
        {
        }
    };

    Class Ingrediente
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1);
            private tipo : TipoIngrediente (1, 1);
            private calorias : Integer (0, 1);
            private g_proteinas : Float (0, 1);
            private g_carbohidratos : Float (0, 1);
            private g_grasas : Float (0, 1);
            private g_racion : Float (0, 1);
            private alergenos : Alergenos(0, *);
            private dietaEspecial : DietaEspecial (0, *);
        }
        
        operations
        {
            public new::New (p_nombre : String, p_tipo : TipoIngrediente, p_calorias : Integer, p_g_proteinas : Float, p_g_carbohidratos : Float, p_g_grasas : Float, p_g_racion : Float, p_alergenos : List<Alergenos>, p_dietaEspecial : List<DietaEspecial>) : Object->Ingrediente;
            public destroy::Destroy (p_oid : OID -> Ingrediente) : Void;
            public modify::Modifier (p_oid : OID -> Ingrediente, p_nombre : String, p_tipo : TipoIngrediente, p_calorias : Integer, p_g_proteinas : Float, p_g_carbohidratos : Float, p_g_grasas : Float, p_g_racion : Float, p_alergenos : List<Alergenos>, p_dietaEspecial : List<DietaEspecial>) : Void;
            public readOID::ReadOID (p_oid : OID -> Ingrediente) : Object->Ingrediente;
            public readAll::ReadAll () : List<Object->Ingrediente>;
        }
    };

    Class IngredienteCompra
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private cantidad: Integer (1,1);
            private comprado : Boolean (1,1);
        }
        
        operations
        {
            public new::New (p_cantidad : Integer, p_fechaCaducidad : Date, p_comprado : Boolean, p_nevera_oid : OID -> Nevera, p_listaCompra_oid : OID -> ListaCompra, p_ingredienteCatalogo_oid : OID -> Ingrediente) : Object->IngredienteCompra;
            public destroy::Destroy (p_oid : OID -> IngredienteCompra) : Void;
            public modify::Modifier (p_oid : OID -> IngredienteCompra, p_cantidad : Integer, p_fechaCaducidad : Date, p_comprado : Boolean, p_nevera_oid : OID -> Nevera, p_listaCompra_oid : OID -> ListaCompra, p_ingredienteCatalogo_oid : OID -> Ingrediente) : Void;
            public readOID::ReadOID (p_oid : OID -> IngredienteCompra) : Object->IngredienteCompra;
            public readAll::ReadAll () : List<Object->IngredienteCompra>;
            public marcarComprado::Custom (p_oid : OID -> IngredienteCompra) : Void;
            public desmarcarComprado::Custom (p_oid : OID -> IngredienteCompra) : Void;
        }
    };

    Class IngredienteNevera
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private cantidad: Integer (1,1);
            private fechaCaducidad : Date (1,1);
        }
        
        operations
        {
            public new::New (p_cantidad : Integer, p_fechaCaducidad : Date, p_ingredienteCatalogo_oid : OID -> Ingrediente, p_nevera_oid : OID -> Nevera, p_receta_oid : OID -> Receta) : Object->IngredienteNevera;
            public destroy::Destroy (p_oid : OID -> IngredienteNevera) : Void;
            public modify::Modifier (p_oid : OID -> IngredienteNevera, p_cantidad : Integer, p_fechaCaducidad : Date) : Void;
            public readOID::ReadOID (p_oid : OID -> IngredienteNevera) : Object->IngredienteNevera;
            public readAll::ReadAll () : List<Object->IngredienteNevera>;
            public comprobarCaducidad::Custom (p_oid : OID -> IngredienteNevera) : Void;
            public filtrarNevera :: ReadFilter (
                    p_nevera_oid : OID -> Nevera,
                    p_tipo : TipoIngrediente,
                    p_fechaLimiteCerca : Date,
                    p_fechaActual : Date,
                    p_estado : EstadoCaducidad
                ) : List<Object -> IngredienteNevera>
                {
                    filterLinQ = "entity => entity.Nevera.Id == p_nevera_oid && (p_tipo == TipoIngrediente.ninguno || entity.IngredienteCatalogo.Tipo == p_tipo) && (p_estado == EstadoCaducidad.ninguno || (p_estado == EstadoCaducidad.perfecto && entity.FechaCaducidad > p_fechaLimiteCerca) || (p_estado == EstadoCaducidad.cerca && entity.FechaCaducidad <= p_fechaLimiteCerca && entity.FechaCaducidad >= p_fechaActual) || (p_estado == EstadoCaducidad.caducado && entity.FechaCaducidad < p_fechaActual))"
                };
        }
    };

    Class Comentario
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private user_id : Integer (1, 1);
