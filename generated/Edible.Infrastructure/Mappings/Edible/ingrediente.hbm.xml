<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="Edible.Domain"
                   namespace="Edible.Domain.Entities">
  <class name="Ingrediente" table="Ingrediente">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Nombre" type="String">
      <column name="nombre" not-null="true"/>
    </property>
    <property name="Tipo" type="Edible.Domain.Enums.TipoIngrediente, Edible.Domain">
      <column name="tipo" not-null="true"/>
    </property>
    <property name="Calorias" type="Int32">
      <column name="calorias"/>
    </property>
    <property name="G_proteinas" type="Single">
      <column name="g_proteinas"/>
    </property>
    <property name="G_carbohidratos" type="Single">
      <column name="g_carbohidratos"/>
    </property>
    <property name="G_grasas" type="Single">
      <column name="g_grasas"/>
    </property>
    <property name="G_racion" type="Single">
      <column name="g_racion"/>
    </property>
    <bag name="Alergenos" table="Ingrediente_alergenos">
      <key>
        <column name="FK_Ingrediente_alergenos"/>
      </key>
      <element column="alergenos" type="Edible.Domain.Enums.Alergenos, Edible.Domain"/>
    </bag>
    <bag name="DietaEspecial" table="Ingrediente_dietaEspecial">
      <key>
        <column name="FK_Ingrediente_dietaEspecial"/>
      </key>
      <element column="dietaEspecial" type="Edible.Domain.Enums.DietaEspecial, Edible.Domain"/>
    </bag>
    <bag name="LineasDeReceta" inverse="true">
      <key>
        <column name="FK_Ingrediente_ingredienteCatalogo"/>
      </key>
      <one-to-many class="LineaReceta"/>
    </bag>
    <bag name="IngredienteEnCompra" inverse="true">
      <key>
        <column name="FK_Ingrediente_ingredienteCatalogo"/>
      </key>
      <one-to-many class="IngredienteCompra"/>
    </bag>
    <bag name="IngredienteEnNevera" inverse="true">
      <key>
        <column name="FK_Ingrediente_ingredienteCatalogo"/>
      </key>
      <one-to-many class="IngredienteNevera"/>
    </bag>
  </class>
  <query name="IngredienteReadAllHQL">from Ingrediente</query>
</hibernate-mapping>
