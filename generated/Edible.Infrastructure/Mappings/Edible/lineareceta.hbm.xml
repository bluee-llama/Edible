<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="Edible.Domain"
                   namespace="Edible.Domain.Entities">
  <class name="LineaReceta" table="LineaReceta">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="CantidadNecesaria" type="Int32">
      <column name="cantidadNecesaria" not-null="true"/>
    </property>
    <many-to-one name="Receta" class="Receta">
      <column name="FK_Receta_receta" not-null="true"/>
    </many-to-one>
    <many-to-one name="IngredienteCatalogo" class="Ingrediente">
      <column name="FK_Ingrediente_ingredienteCatalogo" not-null="true"/>
    </many-to-one>
  </class>
  <query name="LineaRecetaReadAllHQL">from LineaReceta</query>
</hibernate-mapping>
