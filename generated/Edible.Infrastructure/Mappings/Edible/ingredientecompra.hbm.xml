<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="Edible.Domain"
                   namespace="Edible.Domain.Entities">
  <class name="IngredienteCompra" table="IngredienteCompra">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Cantidad" type="Int32">
      <column name="cantidad" not-null="true"/>
    </property>
    <property name="Comprado" type="Boolean">
      <column name="comprado" not-null="true"/>
    </property>
    <many-to-one name="Nevera" class="Nevera">
      <column name="FK_Nevera_nevera" not-null="true"/>
    </many-to-one>
    <many-to-one name="ListaCompra" class="ListaCompra">
      <column name="FK_ListaCompra_listaCompra" not-null="true"/>
    </many-to-one>
    <many-to-one name="IngredienteCatalogo" class="Ingrediente">
      <column name="FK_Ingrediente_ingredienteCatalogo" not-null="true"/>
    </many-to-one>
  </class>
  <query name="IngredienteCompraReadAllHQL">from IngredienteCompra</query>
</hibernate-mapping>
