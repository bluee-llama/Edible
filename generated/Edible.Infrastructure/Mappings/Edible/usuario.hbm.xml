<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="Edible.Domain"
                   namespace="Edible.Domain.Entities">
  <class name="Usuario" table="Usuario">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Name" type="String">
      <column name="name" not-null="true"/>
    </property>
    <property name="Password" type="String">
      <column name="password" not-null="true"/>
    </property>
    <property name="Publico" type="Boolean">
      <column name="publico" not-null="true"/>
    </property>
    <property name="Dieta" type="Edible.Domain.Enums.DietaEspecial, Edible.Domain">
      <column name="dieta" not-null="true"/>
    </property>
    <bag name="Comentario" inverse="true">
      <key>
        <column name="FK_Usuario_comentador"/>
      </key>
      <one-to-many class="Comentario"/>
    </bag>
    <many-to-one name="Nevera" class="Nevera" cascade="delete">
      <column name="FK_Nevera_nevera" not-null="true"/>
    </many-to-one>
    <many-to-one name="ListaCompra" class="ListaCompra" cascade="delete">
      <column name="FK_ListaCompra_listaCompra" not-null="true"/>
    </many-to-one>
    <bag name="RecetasSugeridas">
      <key>
        <column name="FK_Usuario_recetasSugeridas"/>
      </key>
      <one-to-many class="Receta"/>
    </bag>
  </class>
  <query name="UsuarioReadAllHQL">from Usuario</query>
</hibernate-mapping>
