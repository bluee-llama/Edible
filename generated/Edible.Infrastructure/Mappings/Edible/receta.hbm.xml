<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="Edible.Domain"
                   namespace="Edible.Domain.Entities">
  <class name="Receta" table="Receta">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Nombre" type="String">
      <column name="nombre" not-null="true"/>
    </property>
    <property name="Descripcion" type="String">
      <column name="descripcion" not-null="true"/>
    </property>
    <property name="DietaEspecial" type="Edible.Domain.Enums.DietaEspecial, Edible.Domain">
      <column name="dietaEspecial" not-null="true"/>
    </property>
    <property name="ValoracionMedia" type="Single">
      <column name="valoracionMedia" not-null="true"/>
    </property>
    <property name="TiempoRealizacion" type="Int32">
      <column name="tiempoRealizacion" not-null="true"/>
    </property>
    <property name="Dificultad" type="Int32">
      <column name="dificultad" not-null="true"/>
    </property>
    <many-to-one name="Chef" class="Chef">
      <column name="FK_Chef_chef" not-null="true"/>
    </many-to-one>
    <bag name="Pasos" cascade="all-delete-orphan" inverse="true">
      <key>
        <column name="FK_Receta_receta"/>
      </key>
      <one-to-many class="Paso"/>
    </bag>
    <bag name="Lineas" cascade="all-delete-orphan" inverse="true">
      <key>
        <column name="FK_Receta_receta"/>
      </key>
      <one-to-many class="LineaReceta"/>
    </bag>
    <bag name="Comentarios" inverse="true">
      <key>
        <column name="FK_Receta_receta"/>
      </key>
      <one-to-many class="Comentario"/>
    </bag>
    <bag name="IngredientesDisponibles" inverse="true">
      <key>
        <column name="FK_Receta_receta"/>
      </key>
      <one-to-many class="IngredienteNevera"/>
    </bag>
    <bag name="UsuariosSugeridos">
      <key>
        <column name="FK_Receta_usuariosSugeridos"/>
      </key>
      <one-to-many class="Usuario"/>
    </bag>
  </class>
  <query name="RecetaReadAllHQL">from Receta</query>
</hibernate-mapping>
