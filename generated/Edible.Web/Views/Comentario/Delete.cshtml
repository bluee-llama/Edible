@model Edible.Web.ViewModels.ComentarioViewModel

@{
    ViewData["Title"] = "Eliminar";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-danger mb-3">Eliminar</span>
                <h1 class="h3 mb-1">Comentario</h1>
                <p class="text-body-secondary mb-0">Review the record before deleting it. This action cannot be undone.</p>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-2">
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Id)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.User_id)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.User_id)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Imagen)</dt>
            <dd class="col-sm-8 col-lg-9">@if (!string.IsNullOrWhiteSpace(Model.Imagen))
                {
                    <img src="@Url.Content("~/" + Model.Imagen.TrimStart('/'))" alt="@Html.DisplayNameFor(model => model.Imagen)" class="img-thumbnail img-fluid" style="max-width: 320px; max-height: 240px;" />
                }
                else
                {
                    <span class="text-body-secondary">Sin imagen</span>
                }</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Titulo)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Titulo)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Contenido)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Contenido)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Valoracion)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Valoracion)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.ComentadorLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.ComentadorLabel)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.RecetaLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.RecetaLabel)</dd>
                </dl>


            </div>
            <div class="card-footer bg-body p-4">
                <form asp-action="Delete" method="post" class="d-flex flex-column flex-sm-row gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </form>
            </div>
        </div>
    </div>
</div>
