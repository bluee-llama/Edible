@model IEnumerable<Edible.Web.ViewModels.ComentarioViewModel>

@{
    ViewData["Title"] = "Comentario";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Comentario</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Crear</a>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.User_id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Imagen)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Titulo)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Contenido)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Valoracion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.ComentadorLabel)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.RecetaLabel)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.User_id)</td>
                            <td>@if (!string.IsNullOrWhiteSpace(item.Imagen))
                {
                    <img src="@Url.Content("~/" + item.Imagen.TrimStart('/'))" alt="@Html.DisplayNameFor(model => model.Imagen)" class="img-thumbnail object-fit-cover" style="width: 96px; height: 72px;" loading="lazy" />
                }
                else
                {
                    <span class="text-body-secondary">Sin imagen</span>
                }</td>
                            <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Contenido)</td>
                            <td>@Html.DisplayFor(modelItem => item.Valoracion)</td>
                            <td>@Html.DisplayFor(modelItem => item.ComentadorLabel)</td>
                            <td>@Html.DisplayFor(modelItem => item.RecetaLabel)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay registros</h2>
            <p class="text-body-secondary">Crea el primer registro para comenzar.</p>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    }
    </div>
</div>
