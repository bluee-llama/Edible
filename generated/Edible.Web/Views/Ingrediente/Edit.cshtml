            <span asp-validation-for="G_grasas" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="G_racion" class="form-label"></label>
            <input asp-for="G_racion" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="G_racion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Alergenos" class="form-label"></label>
            <select asp-for="Alergenos" asp-items="Html.GetEnumSelectList<Edible.Domain.Enums.Alergenos>()" multiple="multiple" class="form-select"></select>
            <span asp-validation-for="Alergenos" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DietaEspecial" class="form-label"></label>
            <select asp-for="DietaEspecial" asp-items="Html.GetEnumSelectList<Edible.Domain.Enums.DietaEspecial>()" multiple="multiple" class="form-select"></select>
            <span asp-validation-for="DietaEspecial" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
