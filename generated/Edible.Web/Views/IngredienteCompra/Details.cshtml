@* HARIA-WEB GENERATED sha256:1f741c7971c14a12b742c8cd2f3eebad33c9e5c75bf99f8b042aa965ee13c1bd *@
@model Edible.Web.ViewModels.IngredienteCompraViewModel

@{
    ViewData["Title"] = "Detalles";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Detalles</span>
                <h1 class="h3 mb-1">IngredienteCompra</h1>
                <p class="text-body-secondary mb-0">Review the complete record information.</p>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-2">
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Id)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Cantidad)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Cantidad)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Comprado)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Comprado)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.NeveraLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.NeveraLabel)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.ListaCompraLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.ListaCompraLabel)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.IngredienteCatalogoLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.IngredienteCatalogoLabel)</dd>
                </dl>


            </div>
            <div class="card-footer bg-body p-4">
                <div class="d-flex flex-column flex-sm-row gap-2">
                @if (!Model.Comprado)
                {
                    <form asp-action="MarcarComprado" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="p_oid" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-success">Marcar comprado</button>
                    </form>
                }
                else
                {
                    <form asp-action="DesmarcarComprado" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="p_oid" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-warning">Desmarcar comprado</button>
                    </form>
                }
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
            </div>
        </div>
    </div>
</div>
