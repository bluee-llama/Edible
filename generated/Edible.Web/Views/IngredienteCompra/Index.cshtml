@model IEnumerable<Edible.Web.ViewModels.IngredienteCompraViewModel>

@{
    ViewData["Title"] = "IngredienteCompra";
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success" role="status">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">IngredienteCompra</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2">
            <a asp-controller="Nevera" asp-action="RecorrerListaCompra" class="btn btn-outline-primary">Volcar comprados a nevera</a>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Cantidad)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Comprado)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.NeveraLabel)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.ListaCompraLabel)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.IngredienteCatalogoLabel)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.Cantidad)</td>
                            <td>@Html.DisplayFor(modelItem => item.Comprado)</td>
                            <td>@Html.DisplayFor(modelItem => item.NeveraLabel)</td>
                            <td>@Html.DisplayFor(modelItem => item.ListaCompraLabel)</td>
                            <td>@Html.DisplayFor(modelItem => item.IngredienteCatalogoLabel)</td>
                            <td class="text-end text-nowrap">
                                @if (!item.Comprado)
                                {
                                    <form asp-action="MarcarComprado" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="p_oid" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Marcar comprado</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="DesmarcarComprado" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="p_oid" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Desmarcar</button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay registros</h2>
            <p class="text-body-secondary">Crea el primer registro para comenzar.</p>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    }
    </div>
</div>
