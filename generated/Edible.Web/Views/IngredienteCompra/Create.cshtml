@model Edible.Web.ViewModels.IngredienteCompraViewModel

@{
    var esAdmin = User.IsInRole("Administrador");
    ViewData["Title"] = esAdmin ? "Crear IngredienteCompra" : "Añadir producto a mi lista de la compra";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">@(esAdmin ? "Crear" : "Mi Lista de la Compra")</span>
                <h1 class="h3 mb-1">@(esAdmin ? "Ingrediente de Compra" : "Añadir producto a mi lista")</h1>
                <p class="text-body-secondary mb-0">Selecciona el producto e indica la cantidad que necesitas comprar.</p>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="IngredienteCatalogoId" class="form-label">Producto</label>
                        <select asp-for="IngredienteCatalogoId" asp-items="Model.IngredienteCatalogoOptions" class="form-select"><option value="">Selecciona un producto...</option></select>
                        <span asp-validation-for="IngredienteCatalogoId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Cantidad" class="form-label">Cantidad</label>
                        <input asp-for="Cantidad" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Comprado" class="form-check-input" />
                        <label asp-for="Comprado" class="form-check-label">Marcar ya como comprado</label>
                        <span asp-validation-for="Comprado" class="text-danger"></span>
                    </div>
                    @if (esAdmin)
                    {
                        <div class="mb-3">
                            <label asp-for="NeveraId" class="form-label"></label>
                            <select asp-for="NeveraId" asp-items="Model.NeveraOptions" class="form-select"><option value="">Selecciona...</option></select>
                            <span asp-validation-for="NeveraId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ListaCompraId" class="form-label"></label>
                            <select asp-for="ListaCompraId" asp-items="Model.ListaCompraOptions" class="form-select"><option value="">Selecciona...</option></select>
                            <span asp-validation-for="ListaCompraId" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="NeveraId" />
                        <input type="hidden" asp-for="ListaCompraId" />
                    }
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Añadir a la lista</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
