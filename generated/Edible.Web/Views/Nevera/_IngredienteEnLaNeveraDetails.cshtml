@model IEnumerable<Edible.Web.ViewModels.IngredienteNeveraViewModel>

<h2 class="h5 mt-4">IngredienteEnLaNevera</h2>
<table class="table">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.Cantidad)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.FechaCaducidad)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.IngredienteCatalogoLabel)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.RecetaLabel)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <partial name="_IngredienteEnLaNeveraDetailsItem" model="item" />
        }
    </tbody>
</table>
