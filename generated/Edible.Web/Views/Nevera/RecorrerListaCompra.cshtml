@using System.Globalization
@model Edible.Web.ViewModels.RecorrerListaCompraViewModel

@{
    var esAdmin = User.IsInRole("Administrador");
    ViewData["Title"] = esAdmin ? "Volcar lista de compra a la nevera" : "Volcar mis comprados a mi nevera";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Operación transaccional</span>
                <h1 class="h3 mb-1">@(esAdmin ? "Volcar lista de la compra a la nevera" : "Volcar productos comprados a mi nevera")</h1>
                <p class="text-body-secondary mb-0">
                    @(esAdmin
                        ? "Recorre la lista de la compra del usuario seleccionado, suma o añade a su nevera todos los ingredientes marcados como comprados y los elimina de la lista en una única transacción."
                        : "Pasa automáticamente todos los productos que hayas marcado como «Comprado» en tu lista de la compra al stock de tu nevera.")
                </p>
            </div>
            <div class="card-body p-4">
                @if (esAdmin)
                {
                    <form method="get" asp-action="RecorrerListaCompra" class="row g-3 align-items-end mb-4">
                        <div class="col-md-8">
                            <label for="usuarioId" class="form-label">Usuario</label>
                            <select id="usuarioId" name="usuarioId" class="form-select" onchange="this.form.submit()">
                                @foreach (var opt in Model.UsuarioOptions)
                                {
                                    <option value="@opt.Value" selected="@(opt.Value == Model.UsuarioId?.ToString(CultureInfo.InvariantCulture))">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-outline-secondary w-100">Ver estado del usuario</button>
                        </div>
                    </form>
                }

                @if (Model.UsuarioId is int uid)
                {
                    <form asp-action="RecorrerListaCompra" method="post" class="d-flex flex-column flex-sm-row gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="p_usuario_oid" value="@uid" />
                        <button type="submit" class="btn btn-success" disabled="@(Model.TotalComprados == 0)">
                            Volcar comprados a @(esAdmin ? "la nevera" : "mi nevera") (@Model.TotalComprados listos)
                        </button>
                        <a asp-controller="IngredienteCompra" asp-action="Index" class="btn btn-outline-primary">Ir a @(esAdmin ? "ingredientes de compra" : "mi lista de la compra")</a>
                        <a asp-controller="IngredienteNevera" asp-action="Index" class="btn btn-outline-secondary">Ir a @(esAdmin ? "ingredientes en nevera" : "mi nevera")</a>
                    </form>
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-body p-4">
                        <h2 class="h5 mb-1">1. @(esAdmin && Model.UsuarioNombre is not null ? $"Lista de la compra de {Model.UsuarioNombre}" : "Mi Lista de la Compra")</h2>
                        <p class="text-body-secondary mb-0">Solo los productos marcados como «Comprado» pasarán a la nevera.</p>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.ItemsListaCompra.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Producto</th>
                                            <th scope="col">Cantidad</th>
                                            <th scope="col" class="text-end">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in Model.ItemsListaCompra)
                                    {
                                        <tr class="@(item.Comprado ? "table-success" : null)">
                                            <td class="fw-semibold">@item.IngredienteNombre</td>
                                            <td>@item.Cantidad</td>
                                            <td class="text-end">
                                                @if (item.Comprado)
                                                {
                                                    <span class="badge text-bg-success">Comprado (se volcará)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-secondary">Pendiente</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-body-secondary p-4 mb-0">La lista de la compra está vacía.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-body p-4">
                        <h2 class="h5 mb-1">2. @(esAdmin && Model.UsuarioNombre is not null ? $"Stock en Nevera de {Model.UsuarioNombre}" : "Stock actual en Mi Nevera")</h2>
                        <p class="text-body-secondary mb-0">Si el alimento ya existe en tu nevera, se sumará su cantidad automáticamente.</p>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.ItemsNevera.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Alimento</th>
                                            <th scope="col">Cantidad</th>
                                            <th scope="col" class="text-end">Caducidad</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in Model.ItemsNevera)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.IngredienteNombre</td>
                                            <td>@item.Cantidad</td>
                                            <td class="text-end">@item.FechaCaducidad.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-body-secondary p-4 mb-0">La nevera no tiene alimentos todavía.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
