@model Edible.Web.ViewModels.IngredienteNeveraViewModel

@{
    var esAdmin = User.IsInRole("Administrador");
    ViewData["Title"] = esAdmin ? "Editar IngredienteNevera" : "Editar producto de mi nevera";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">@(esAdmin ? "Editar" : "Mi Nevera")</span>
                <h1 class="h3 mb-1">@(esAdmin ? "Ingrediente en Nevera" : "Editar producto de mi nevera")</h1>
                <p class="text-body-secondary mb-0">Actualiza la cantidad o la fecha de caducidad del alimento.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="IngredienteCatalogoId" class="form-label">Alimento</label>
                        <select asp-for="IngredienteCatalogoId" asp-items="Model.IngredienteCatalogoOptions" class="form-select"><option value="">Selecciona...</option></select>
                        <span asp-validation-for="IngredienteCatalogoId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Cantidad" class="form-label">Cantidad</label>
                        <input asp-for="Cantidad" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FechaCaducidad" class="form-label">Fecha de caducidad</label>
                        <input asp-for="FechaCaducidad" type="date" class="form-control" />
                        <span asp-validation-for="FechaCaducidad" class="text-danger"></span>
                    </div>
                    @if (esAdmin)
                    {
                        <div class="mb-3">
                            <label asp-for="NeveraId" class="form-label"></label>
                            <select asp-for="NeveraId" asp-items="Model.NeveraOptions" class="form-select"><option value="">Selecciona...</option></select>
                            <span asp-validation-for="NeveraId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="RecetaId" class="form-label"></label>
                            <select asp-for="RecetaId" asp-items="Model.RecetaOptions" class="form-select"><option value="">Selecciona...</option></select>
                            <span asp-validation-for="RecetaId" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="NeveraId" />
                        <input type="hidden" asp-for="RecetaId" />
                    }
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
