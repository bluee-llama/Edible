@using System.Globalization
@using Edible.Domain.Enums
@model Edible.Web.ViewModels.BusquedaAvanzadaViewModel

@{
    ViewData["Title"] = "Búsqueda avanzada de recetas";
    var dietas = Html.GetEnumSelectList<DietaEspecial>();
    var alergenos = Html.GetEnumSelectList<Alergenos>();
    // type="number" siempre envía el decimal con punto, que es lo que espera el filtro GET.
    var nota = Model.NotaMinima.ToString("0.##", CultureInfo.InvariantCulture);
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-body p-4">
        <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Filtro</span>
        <h1 class="h3 mb-1">Búsqueda avanzada de recetas</h1>
        <p class="text-body-secondary mb-0">
            Combina los criterios que quieras. Déjalos en "Cualquiera" o a 0 para no filtrar por ellos.
        </p>
    </div>
    <form method="get" asp-action="BusquedaAvanzada">
        <div class="card-body p-4">
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6 col-lg-4">
                    <label for="p_dieta" class="form-label">Dieta especial</label>
                    <select id="p_dieta" name="p_dieta" class="form-select">
                        @foreach (var item in dietas)
                        {
                            <option value="@item.Value" selected="@(item.Value == ((int)Model.Dieta).ToString())">@(item.Text == "ninguna" ? "Cualquiera" : item.Text)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label for="p_alergenoExcluido" class="form-label">Excluir alérgeno</label>
                    <select id="p_alergenoExcluido" name="p_alergenoExcluido" class="form-select">
                        @foreach (var item in alergenos)
                        {
                            <option value="@item.Value" selected="@(item.Value == ((int)Model.AlergenoExcluido).ToString())">@(item.Text == "ninguno" ? "Ninguno" : item.Text)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label for="p_ingrediente_oid" class="form-label">Ingrediente que debe contener</label>
                    <select id="p_ingrediente_oid" name="p_ingrediente_oid" class="form-select">
                        <option value="0">Cualquiera</option>
                        @foreach (var item in Model.IngredienteOptions)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.IngredienteId.ToString(CultureInfo.InvariantCulture))">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-3">
                    <label for="p_notaMinima" class="form-label">Nota mínima (0 a 5)</label>
                    <input id="p_notaMinima" name="p_notaMinima" type="number" step="0.1" min="0" max="5" value="@nota" class="form-control" required />
                </div>
                <div class="col-6 col-lg-3">
                    <label for="p_dificultad" class="form-label">Dificultad (0 = cualquiera)</label>
                    <input id="p_dificultad" name="p_dificultad" type="number" step="1" min="0" value="@Model.Dificultad" class="form-control" required />
                </div>
                <div class="col-6 col-lg-3">
                    <label for="p_tiempoMin" class="form-label">Tiempo mínimo (min)</label>
                    <input id="p_tiempoMin" name="p_tiempoMin" type="number" step="1" min="0" value="@Model.TiempoMin" class="form-control" required />
                </div>
                <div class="col-6 col-lg-3">
                    <label for="p_tiempoMax" class="form-label">Tiempo máximo (0 = sin límite)</label>
                    <input id="p_tiempoMax" name="p_tiempoMax" type="number" step="1" min="0" value="@Model.TiempoMax" class="form-control" required />
                </div>
            </div>
        </div>
        <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="BusquedaAvanzada" class="btn btn-outline-secondary">Limpiar filtros</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
        </div>
    </form>
</div>

@if (Model.Buscado)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-body p-4">
            <h2 class="h5 mb-0">Resultados (@Model.Resultados.Count)</h2>
        </div>
        <div class="card-body p-0">
            @if (Model.Resultados.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Receta</th>
                                <th scope="col">Dieta</th>
                                <th scope="col">Valoración media</th>
                                <th scope="col">Tiempo (min)</th>
                                <th scope="col">Dificultad</th>
                                <th scope="col">Chef</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Resultados)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.DietaEspecial</td>
                                <td>@item.ValoracionMedia.ToString("0.0#")</td>
                                <td>@item.TiempoRealizacion</td>
                                <td>@item.Dificultad</td>
                                <td>@item.ChefLabel</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <h2 class="h5">Sin coincidencias</h2>
                    <p class="text-body-secondary mb-0">Ninguna receta cumple todos los criterios. Prueba a relajar alguno.</p>
                </div>
            }
        </div>
    </div>
}
