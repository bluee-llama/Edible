@* HARIA-WEB MANUAL: tabla de resultados reutilizada por BuscarNombre y RecetasPorNevera *@
@model IEnumerable<Edible.Web.ViewModels.RecetaViewModel>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Dieta especial</th>
                    <th scope="col">Valoración</th>
                    <th scope="col">Tiempo (min)</th>
                    <th scope="col">Dificultad</th>
                    <th scope="col">Chef</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.DietaEspecial</td>
                    <td>@item.ValoracionMedia.ToString("0.0")</td>
                    <td>@item.TiempoRealizacion</td>
                    <td>@item.Dificultad</td>
                    <td>@item.ChefLabel</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center p-5">
        <h2 class="h5">Sin resultados</h2>
        <p class="text-body-secondary mb-0">No hay recetas que cumplan el criterio indicado.</p>
    </div>
}