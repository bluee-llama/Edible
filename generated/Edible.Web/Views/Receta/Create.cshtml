@* HARIA-WEB MANUAL: vista editada a mano (el desplegable de Chef solo lo ve el administrador) *@
@model Edible.Web.ViewModels.RecetaViewModel

@{
    ViewData["Title"] = "Crear";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Crear</span>
                <h1 class="h3 mb-1">Receta</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <input asp-for="Descripcion" class="form-control" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DietaEspecial" class="form-label"></label>
            <select asp-for="DietaEspecial" asp-items="Html.GetEnumSelectList<Edible.Domain.Enums.DietaEspecial>()" class="form-select"></select>
            <span asp-validation-for="DietaEspecial" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ValoracionMedia" class="form-label"></label>
            <input asp-for="ValoracionMedia" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="ValoracionMedia" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TiempoRealizacion" class="form-label"></label>
            <input asp-for="TiempoRealizacion" class="form-control" />
            <span asp-validation-for="TiempoRealizacion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Dificultad" class="form-label"></label>
            <input asp-for="Dificultad" class="form-control" />
            <span asp-validation-for="Dificultad" class="text-danger"></span>
        </div>
        @if (Edible.Web.Controllers.RecetaWebSupport.IsAdmin(User))
        {
            <div class="mb-3">
                <label asp-for="ChefId" class="form-label"></label>
                <select asp-for="ChefId" asp-items="Model.ChefOptions" class="form-select"><option value="">Selecciona...</option></select>
                <span asp-validation-for="ChefId" class="text-danger"></span>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="ChefId" />
            <p class="text-body-secondary">La receta se publicará a tu nombre.</p>
        }
        <partial name="_Pasos" model="Model" />
        <partial name="_Lineas" model="Model" />
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>
    <script src="~/js/haria-compositions.js" asp-append-version="true"></script>
}