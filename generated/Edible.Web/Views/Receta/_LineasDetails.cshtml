@model IEnumerable<Edible.Web.ViewModels.LineaRecetaViewModel>

<h2 class="h5 mt-4">Lineas</h2>
<table class="table">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.CantidadNecesaria)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.IngredienteCatalogoLabel)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <partial name="_LineasDetailsItem" model="item" />
        }
    </tbody>
</table>
