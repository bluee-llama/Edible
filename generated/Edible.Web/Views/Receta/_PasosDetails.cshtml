@model IEnumerable<Edible.Web.ViewModels.PasoViewModel>

<h2 class="h5 mt-4">Pasos</h2>
<table class="table">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.Nombre)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Descripcion)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <partial name="_PasosDetailsItem" model="item" />
        }
    </tbody>
</table>
