@model IEnumerable<Edible.Web.ViewModels.RecetaViewModel>

@{
    ViewData["Title"] = "Receta";
    var puedeCrear = User.IsInRole("Chef") || User.IsInRole("Administrador");
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Receta</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2">
            <a asp-action="BusquedaAvanzada" class="btn btn-outline-primary">Búsqueda avanzada</a>
            @if (puedeCrear)
            {
                <a asp-action="Create" class="btn btn-primary">Crear</a>
            }
        </div>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.DietaEspecial)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.ValoracionMedia)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.TiempoRealizacion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Dificultad)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.ChefLabel)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                            <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                            <td>@Html.DisplayFor(modelItem => item.DietaEspecial)</td>
                            <td>@Html.DisplayFor(modelItem => item.ValoracionMedia)</td>
                            <td>@Html.DisplayFor(modelItem => item.TiempoRealizacion)</td>
                            <td>@Html.DisplayFor(modelItem => item.Dificultad)</td>
                            <td>@Html.DisplayFor(modelItem => item.ChefLabel)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                @if (Edible.Web.Controllers.RecetaWebSupport.CanManageReceta(User, item.ChefId))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                }
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay registros</h2>
            <p class="text-body-secondary">Crea el primer registro para comenzar.</p>
            @if (puedeCrear)
            {
                <a asp-action="Create" class="btn btn-primary">Crear</a>
            }
        </div>
    }
    </div>
</div>
