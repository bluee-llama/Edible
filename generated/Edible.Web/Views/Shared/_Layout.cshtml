<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d6efd" />
    <title>@ViewData["Title"] · Edible.Web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Edible.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Edible.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    @{
                        var autenticado = User.Identity?.IsAuthenticated == true;
                        var esChef = User.IsInRole("Chef");
                        var esAdmin = User.IsInRole("Administrador");
                    }
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        @if (autenticado)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mi cocina</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Nevera" asp-action="Index">Neveras</a></li>
                                    <li><a class="dropdown-item" asp-controller="IngredienteNevera" asp-action="Index">Ingredientes en la nevera</a></li>
                                    <li><a class="dropdown-item" asp-controller="ListaCompra" asp-action="Index">Listas de la compra</a></li>
                                    <li><a class="dropdown-item" asp-controller="IngredienteCompra" asp-action="Index">Ingredientes de la compra</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Recetas</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Receta" asp-action="Index">Recetas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Receta" asp-action="BusquedaAvanzada">Búsqueda avanzada</a></li>
                                    <li><a class="dropdown-item" asp-controller="Comentario" asp-action="Index">Comentarios</a></li>
                                </ul>
                            </li>
                        }
                        @if (esChef || esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Catálogo (Chef)</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Ingrediente" asp-action="Index">Ingredientes</a></li>
                                    <li><a class="dropdown-item" asp-controller="LineaReceta" asp-action="Index">Líneas de receta</a></li>
                                    <li><a class="dropdown-item" asp-controller="Paso" asp-action="Index">Pasos</a></li>
                                </ul>
                            </li>
                        }
                        @if (esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Chef" asp-action="Index">Chefs</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
                    </ul>
                    <div class="d-flex align-items-lg-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Usuario" asp-action="Perfil">Mi perfil</a>
                        <span class="navbar-text text-white-50 small">
                            #@User.Identity.Name
                            <span class="badge text-bg-light text-primary">@(esAdmin ? "Administrador" : esChef ? "Chef" : "Usuario")</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Usuario" asp-action="Register">Registrarse</a>
                    }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4 py-lg-5">
        @foreach (var (clave, clase) in new[] { ("Success", "success"), ("Warning", "warning"), ("Error", "danger") })
        {
            if (TempData[clave] is string mensaje && !string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert alert-@clase alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
        }
        @RenderBody()
    </main>

    <footer class="border-top bg-body py-3 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
            <span>&copy; @DateTime.Now.Year Edible.Web</span>
            <a asp-controller="Home" asp-action="Privacy" class="link-secondary">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
