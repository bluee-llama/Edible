@* Lista compacta de recetas (Home y perfiles). El llamador decide qué mostrar si la lista está vacía. *@
@model List<Edible.Web.ViewModels.RecetaResumenViewModel>

@if (Model.Count > 0)
{
    <div class="list-group list-group-flush">
        @foreach (var receta in Model)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start gap-2"
               asp-controller="Receta" asp-action="Details" asp-route-id="@receta.Id">
                <div>
                    <div class="fw-semibold">@receta.Nombre</div>
                    <div class="small text-body-secondary">por @receta.ChefNombre · @receta.TiempoRealizacion min · dificultad @receta.Dificultad</div>
                </div>
                <div class="text-end text-nowrap">
                    @if (receta.ValoracionMedia > 0)
                    {
                        <span class="badge text-bg-warning">★ @receta.ValoracionMedia.ToString("0.0")</span>
                    }
                    @if (receta.Dieta != Edible.Domain.Enums.DietaEspecial.ninguna)
                    {
                        <span class="badge text-bg-success-subtle text-success-emphasis">@receta.Dieta</span>
                    }
                </div>
            </a>
        }
    </div>
}
